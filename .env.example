# Docker 部署配置（复制为 .env）
PANGU_TAG=latest
# 镜像名：默认 ghcr.io/just805/pangu（amd64/arm64 双架构，CI 随版本发布）
# PANGU_IMAGE=ghcr.io/just805/pangu
POSTGRES_USER=pangu

# [必改] 数据库唯一口令。下面的占位值不换 = 数据库对知道该值的任何人敞开；
# 拿到 DB 口令可通过 reset-password.sh 重置管理员密码，完成平台接管。
# 生成强口令：openssl rand -base64 18
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=pangu

# 容器时区（任务时间戳 / 报告 / 周期调度用）。留空 = UTC。install.sh 部署会自动填成宿主机时区。
# TZ=Asia/Shanghai

# LLM（二选一或都填；也可留空到 UI 里配）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
PANGU_LLM_PROVIDER=
PANGU_LLM_MODEL=
PANGU_LLM_BASE_URL=
PANGU_LLM_PROXY=
